#!/bin/bash
# Portable newline-delimited selection menu. No command execution.
set -euo pipefail
usage() {
  cat <<'HELP'
Usage: dotfiles-menu [-p|--prompt TEXT] [--allow-custom]
Reads newline-separated choices from stdin; writes a selected item to stdout.
By default only listed choices are allowed. --allow-custom permits typed text.
Esc cancels (normally exit 1). Other backend exit statuses are preserved.
HELP
}
prompt='Select:'
custom=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    -p|--prompt) [[ $# -ge 2 ]] || { usage >&2; exit 2; }; prompt=$2; shift 2;;
    --allow-custom) custom=true; shift;;
    -h|--help) usage; exit 0;;
    *) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; exit 2;;
  esac
done
[[ ! -t 0 ]] || { printf 'Pipe choices into dotfiles-menu.\n' >&2; exit 2; }
case "$(uname -s)" in
  Linux)
    command -v rofi >/dev/null || { echo 'rofi not found on PATH' >&2; exit 127; }
    args=(-dmenu -i -matching fuzzy -format s -p "$prompt")
    if [[ "$custom" == false ]]; then args+=(-no-custom); fi
    exec rofi "${args[@]}"
    ;;
  Darwin)
    echo 'dotfiles-menu is a Linux/Rofi interface. On macOS, use Spotlight.' >&2
    exit 69
    ;;
  *) echo 'Unsupported operating system' >&2; exit 2;;
esac
