#!/usr/bin/env bash

set -euo pipefail

umask 077

script_name="$(basename "$0")"

print_usage() {
  cat <<EOF
Encrypt, verify, and restore 1Password 1PUX backups.

Usage:
  $script_name encrypt INPUT.1pux [OUTPUT_DIRECTORY]
  $script_name verify INPUT.1pux.age
  $script_name decrypt INPUT.1pux.age [OUTPUT.1pux]

Commands:
  encrypt  Encrypt a 1PUX export and verify the encrypted result.
  verify   Verify that an encrypted backup can be decrypted.
  decrypt  Restore an encrypted backup to a plaintext 1PUX file.
EOF
}

die() {
  printf '%s: %s\n' "$script_name" "$*" >&2
  exit 1
}

require_command() {
  local command_name="$1"

  if command -v "$command_name" >/dev/null 2>&1; then
    return
  else
    die "required command not found: $command_name"
  fi
}

verify_encrypted_file() {
  local encrypted_file="$1"
  local expected_sha256="${2:-}"
  local decrypted_sha256

  printf 'Verifying encrypted backup:\n'
  printf '  %s\n\n' "$encrypted_file"

  if decrypted_sha256="$(
    age --decrypt "$encrypted_file" |
      sha256sum |
      awk '{print $1}'
  )"; then
    :
  else
    die "could not decrypt the encrypted backup"
  fi

  if [ -n "$expected_sha256" ]; then
    if [ "$decrypted_sha256" = "$expected_sha256" ]; then
      printf '%s\n' "Encrypted backup matches the original file."
    else
      die "decrypted content does not match the original file"
    fi
  else
    printf '%s\n' "Encrypted backup was decrypted successfully."
  fi
}

encrypt_backup() {
  local source_file="${1:-}"
  local output_directory="${2:-}"
  local source_filename
  local source_basename
  local timestamp
  local encrypted_file
  local original_sha256
  local delete_answer

  if [ -z "$source_file" ]; then
    print_usage
    exit 2
  fi

  if [ ! -f "$source_file" ]; then
    die "input file not found: $source_file"
  fi

  if [[ "$source_file" != *.1pux ]]; then
    die "expected a .1pux file: $source_file"
  fi

  if [ -z "$output_directory" ]; then
    output_directory="$(dirname -- "$source_file")"
  fi

  mkdir -p -- "$output_directory"

  source_filename="$(basename -- "$source_file")"
  source_basename="${source_filename%.1pux}"
  timestamp="$(date '+%Y%m%d-%H%M%S')"

  encrypted_file="$output_directory/${source_basename}-${timestamp}.1pux.age"

  if [ -e "$encrypted_file" ] || [ -L "$encrypted_file" ]; then
    die "output already exists: $encrypted_file"
  fi

  original_sha256="$(
    sha256sum "$source_file" |
      awk '{print $1}'
  )"

  printf 'Encrypting 1Password export:\n'
  printf '  Source: %s\n' "$source_file"
  printf '  Output: %s\n\n' "$encrypted_file"

  printf '%s\n' \
    "Leave the passphrase prompt empty to let age generate a secure passphrase."
  printf '%s\n\n' \
    "Store the passphrase separately from both 1Password and this backup."

  age \
    --passphrase \
    --output "$encrypted_file" \
    "$source_file"

  if [ -s "$encrypted_file" ]; then
    :
  else
    die "encrypted output was not created correctly"
  fi

  printf '\n'
  verify_encrypted_file "$encrypted_file" "$original_sha256"

  printf '\nEncrypted backup created:\n'
  printf '  %s\n\n' "$encrypted_file"

  printf 'Plaintext source:\n'
  printf '  %s\n\n' "$source_file"

  read -r -p "Delete the plaintext source now? [y/N]: " delete_answer

  if [ "$delete_answer" = "y" ]; then
    rm -- "$source_file"
    printf '%s\n' "Deleted plaintext source."
  elif [ "$delete_answer" = "Y" ]; then
    rm -- "$source_file"
    printf '%s\n' "Deleted plaintext source."
  else
    printf '%s\n' \
      "Plaintext source retained. Remove it after confirming the backup."
  fi
}

verify_backup() {
  local encrypted_file="${1:-}"

  if [ -z "$encrypted_file" ]; then
    print_usage
    exit 2
  fi

  if [ ! -f "$encrypted_file" ]; then
    die "encrypted file not found: $encrypted_file"
  fi

  if [[ "$encrypted_file" != *.1pux.age ]]; then
    die "expected a .1pux.age file: $encrypted_file"
  fi

  verify_encrypted_file "$encrypted_file"
}

decrypt_backup() {
  local encrypted_file="${1:-}"
  local output_file="${2:-}"

  if [ -z "$encrypted_file" ]; then
    print_usage
    exit 2
  fi

  if [ ! -f "$encrypted_file" ]; then
    die "encrypted file not found: $encrypted_file"
  fi

  if [[ "$encrypted_file" != *.1pux.age ]]; then
    die "expected a .1pux.age file: $encrypted_file"
  fi

  if [ -z "$output_file" ]; then
    output_file="${encrypted_file%.age}"
  fi

  if [[ "$output_file" != *.1pux ]]; then
    die "expected the output filename to end in .1pux: $output_file"
  fi

  if [ -e "$output_file" ] || [ -L "$output_file" ]; then
    die "refusing to overwrite existing file: $output_file"
  fi

  age \
    --decrypt \
    --output "$output_file" \
    "$encrypted_file"

  if [ -s "$output_file" ]; then
    :
  else
    die "restored output was not created correctly"
  fi

  printf '\nRestored plaintext export:\n'
  printf '  %s\n\n' "$output_file"

  printf '%s\n' \
    "This file is unencrypted. Delete it after completing the import."
}

main() {
  local command_name="${1:-}"

  require_command age
  require_command awk
  require_command sha256sum

  if [ -z "$command_name" ]; then
    print_usage
    exit 2
  fi

  shift

  if [ "$command_name" = "encrypt" ]; then
    encrypt_backup "$@"
  elif [ "$command_name" = "verify" ]; then
    verify_backup "$@"
  elif [ "$command_name" = "decrypt" ]; then
    decrypt_backup "$@"
  elif [ "$command_name" = "--help" ]; then
    print_usage
  elif [ "$command_name" = "-h" ]; then
    print_usage
  else
    printf '%s: unknown command: %s\n\n' \
      "$script_name" \
      "$command_name" >&2

    print_usage >&2
    exit 2
  fi
}

main "$@"
