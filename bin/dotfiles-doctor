#!/bin/bash
# Read-only configuration and executable diagnostics (Bash 3.2 compatible).
set -u
failures=0
warnings=0
ok() { printf 'OK: %s\n' "$*"; }
fail() { printf 'FAIL: %s\n' "$*" >&2; failures=$((failures + 1)); }
warn() { printf 'Warning: %s\n' "$*" >&2; warnings=$((warnings + 1)); }
case "${1:-}" in -h|--help) echo 'Usage: dotfiles-doctor (checks current PATH and installed links)'; exit 0;; '') ;; *) exit 2;; esac
printf 'Platform: %s / %s\n' "$(uname -s)" "$(uname -m)"
# This executable is normally symlinked from ~/.local/bin. Resolve the source
# without GNU readlink -f, which is not available on all Macs.
source_path=${BASH_SOURCE[0]}
for ((i=0; i<20; i++)); do
  [[ -L "$source_path" ]] || break
  target=$(readlink "$source_path") || exit 1
  case "$target" in /*) source_path=$target;; *) source_path="$(dirname "$source_path")/$target";; esac
done
root=$(cd -P -- "$(dirname "$source_path")/.." && pwd -P) || exit 1
if bash "$root/install.sh" --verify; then ok 'Managed links'; else fail 'Managed links differ or cannot be checked'; fi
for tool in fish tmux git mise nvim yazi fzf rg eza zoxide just lazygit; do
  case "$tool" in tmux) flag=-V;; *) flag=--version;; esac
  if command -v "$tool" >/dev/null 2>&1 && "$tool" "$flag" >/dev/null 2>&1; then
    ok "$tool: $(command -v "$tool")"
  else
    case "$tool" in eza|fzf|zoxide|lazygit) warn "$tool unavailable or broken";; *) fail "$tool unavailable or broken";; esac
  fi
done
if command -v fish >/dev/null 2>&1 && fish -n "${XDG_CONFIG_HOME:-$HOME/.config}/fish/config.fish"; then ok 'Fish syntax'; else fail 'Fish config syntax'; fi
if [[ -x "$HOME/.local/bin/dotfiles-terminal" ]]; then ok 'Terminal launcher'; else fail 'Terminal launcher missing'; fi
if [[ "$(uname -s)" == Darwin ]]; then
  login=$(dscl . -read "/Users/$(id -un)" UserShell 2>/dev/null) || login=''
  case "$login" in */fish) ok "Login shell: $login";; *) warn "Login shell is not Fish: $login";; esac
else
  case "${SHELL:-}" in */fish) ok "Login environment: $SHELL";; *) warn 'Login environment is not Fish'; esac
fi
if shell=$(tmux show-options -gv default-shell 2>/dev/null); then
  case "$shell" in */fish) ok "tmux default-shell: $shell";; *) warn "tmux default-shell: $shell";; esac
else warn 'No accessible tmux server; test a new terminal manually'; fi
printf 'Required failures: %s; advisory warnings: %s\n' "$failures" "$warnings"
((failures == 0))
