#!/usr/bin/env bash
set -euo pipefail

script_name="$(basename "$0")"

usage() {
  cat <<EOF
Open Hex documentation for an Elixir package.

Usage:
  $script_name [PACKAGE]

PACKAGE defaults to elixir.
EOF
}

case "${1:-}" in
  --help | -h)
    usage
    exit 0
    ;;
esac

if [[ $# -gt 1 ]]; then
  usage >&2
  exit 2
fi

if ! command -v mix >/dev/null 2>&1; then
  printf '%s: mix is required\n' "$script_name" >&2
  exit 1
fi

exec mix hex.docs online "${1:-elixir}"
