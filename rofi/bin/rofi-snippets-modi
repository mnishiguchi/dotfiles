#!/usr/bin/env bash
# Native Rofi script mode; share parsing and evaluation with macOS.
set -euo pipefail
engine="$HOME/.local/bin/dotfiles-snippets"
[[ -x "$engine" ]] || { echo 'Install dotfiles-snippets with install.sh --only bin,rofi' >&2; exit 1; }
case "${1:-}" in
  Quit) exit 0;;
  '')
    printf '\0prompt\x1fsnippet\n'
    printf '\0message\x1fSnippets starting with cmd are executed.\n'
    "$engine" --list
    printf '%s\n' Quit;;
  *)
    case "${ROFI_RETV:-0}" in
      1)
        # Preserve the existing X11 typing behavior and let Rofi close first.
        command -v xdotool >/dev/null || { echo 'xdotool required' >&2; exit 1; }
        value=$("$engine" --print "$1") || exit $?
        # Close Rofi's output pipe immediately so it can dismiss the menu
        # before xdotool types into the previously focused window.
        (sleep 0.2; printf '%s' "$value" | xdotool type --clearmodifiers --file -) >/dev/null 2>&1 &
        ;;
      2)
        # Match the documented behavior: copy evaluated command output.
        "$engine" --copy "$1"
        if command -v notify-send >/dev/null; then notify-send 'Snippet copied to clipboard' || true; fi;;
      *) exit 1;;
    esac;;
esac
